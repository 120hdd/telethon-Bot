# Telegram user account (international format; this selects the account at login)
TELEGRAM_PHONE=+10000000000

# API credential mode: auto | custom | public
TELEGRAM_API_MODE=auto

# Custom application credentials from my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Intentionally configured shared/public fallback credentials
TELEGRAM_PUBLIC_API_ID=
TELEGRAM_PUBLIC_API_HASH=

# Persistent, profile-separated Telethon sessions
TELEGRAM_SESSION_DIR=./data/sessions

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
UPLOADS_DIR=./data/uploads
LOG_PATH=./logs/app.log

LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_MESSAGE_BODIES=false

CONTROL_SAVED_MESSAGES=true
DRY_RUN=false
LOCAL_TIMEZONE=Asia/Tehran

DEFAULT_SEND_INTERVAL_SECONDS=8
MAX_QUEUE_ATTEMPTS=5
MAX_AUTOMATIC_FLOOD_WAIT_SECONDS=300
WORKER_POLL_SECONDS=1
MAX_MEDIA_BYTES=2147483648
